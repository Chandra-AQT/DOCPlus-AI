# ── Copy this file to .env and fill in your values ──────────────────────────
# Railway will inject these as environment variables automatically.
# You do NOT need a .env file on Railway — set them in the Railway dashboard.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters

# Your Vercel frontend URL (set after Vercel deployment)
FRONTEND_URL=https://your-app.vercel.app

# Admin email — only this email can access the admin panel
ADMIN_EMAIL=chandra.paidimukkala@aquarient.com

# ── OPTIONAL: LandingAI (can also be set in Admin Panel → AI Config) ─────────
LANDINGAI_API_KEY=
LANDINGAI_BASE_URL=production

# ── OPTIONAL: OpenAI (guests can use this via Admin Panel) ───────────────────
OPENAI_API_KEY=

# ── OPTIONAL: Email notifications (MS Graph API) ─────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=

# ── OPTIONAL: Email notifications (SMTP fallback) ────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── OPTIONAL: Storage ─────────────────────────────────────────────────────────
# On Railway free tier, use /tmp (ephemeral). For persistence, mount a volume.
UPLOAD_DIR=/tmp/uploads

# ── OPTIONAL: Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
