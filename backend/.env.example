# ── REQUIRED ─────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
FRONTEND_URL=https://your-frontend.up.railway.app
ADMIN_EMAIL=chandra.paidimukkala@aquarient.com

# ── OPTIONAL: LandingAI (or set via Admin Panel → AI Config) ─────────────────
LANDINGAI_API_KEY=
LANDINGAI_BASE_URL=production

# ── OPTIONAL: Salesforce CRM — auto-creates Lead on guest registration ────────
# Setup guide:
#   1. Go to Salesforce Setup → Apps → App Manager → New Connected App
#   2. Enable OAuth Settings → Add scopes: api, refresh_token
#   3. Copy Consumer Key → SF_CLIENT_ID
#   4. Copy Consumer Secret → SF_CLIENT_SECRET
#   5. SF_PASSWORD = your login password + security token (no space)
#      e.g. password=MyPass, token=ABC123 → SF_PASSWORD=MyPassABC123
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_DOMAIN=login.salesforce.com

# ── OPTIONAL: Email notifications (MS Graph API) ─────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=

# ── OPTIONAL: Email notifications (SMTP fallback) ────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/uploads
LOG_LEVEL=INFO
